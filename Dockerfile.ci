FROM registry.access.redhat.com/ubi9/ubi:latest

# Base tools (mirrors strat-pipeline's setup-claude-ci.sh, baked in for speed)
RUN dnf install -y --nodocs --allowerasing \
        git-core \
        shadow-utils \
        util-linux \
        python3.11 \
        python3.11-pip \
        python3.11-devel \
        gcc \
        make \
        diffutils \
        patch \
        findutils \
        which \
        tar \
        gzip \
        unzip \
        curl \
        wget \
        xz \
        libatomic \
    && dnf clean all \
    && alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && alternatives --install /usr/bin/pip3 pip3 /usr/bin/pip3.11 1 \
    # Unversioned aliases: a target repo's Makefile may call `pip` or `python`
    # rather than `pip3`/`python3`, which would otherwise exit 127.
    && ln -sf /usr/bin/pip3 /usr/bin/pip \
    && ln -sf /usr/bin/python3 /usr/bin/python

# Go 1.24 (required by mlflow-go)
ARG TARGETARCH
RUN curl -fsSL "https://go.dev/dl/go1.24.4.linux-${TARGETARCH}.tar.gz" | tar -C /usr/local -xzf -
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/home/claude-ci/go"

# Node.js 26 — the highest floor any target sets, so one runtime serves all.
# odh-dashboard needs >= 22; rh-forge-ui needs ^24.15.0 || >= 26 AND sets
# engine-strict=true in .npmrc, which turns a too-old Node from a warning into
# a failed install. Was 22, which satisfied the first and hard-failed the
# second.
# Installed from the official tarball (like Go) instead of NodeSource, which
# has no arm64 RPMs for Node 26 on UBI9 — causing a silent fallback to the
# system Node 16 and a missing corepack.
ARG NODE_VERSION=26.0.0
RUN ARCH=$([ "$TARGETARCH" = "amd64" ] && echo "x64" || echo "arm64") \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${ARCH}.tar.xz" \
       | tar -C /usr/local --strip-components=1 -xJf - \
    && npm install -g yarn markdownlint-cli

# pnpm — installed globally via npm. Node 26 dropped corepack, so the
# corepack shim approach no longer works. A repo pinning
# `packageManager: pnpm@x.y.z` in package.json won't auto-select that
# exact version, but CI locks resolve the same tree regardless.
RUN npm install -g pnpm \
    && pnpm --version

# JS/TS check tooling. `npm run lint` prepends the repo's node_modules/.bin,
# so a repo that pins its own eslint/tsc/vitest still gets that one; these are
# the fallback for when it does not resolve, which otherwise exits 127 and
# makes every JS check unrunnable.
RUN npm install -g eslint typescript vitest

# Python packages needed by epic-code-gen
RUN pip3 install --no-cache-dir pyyaml pytest

# uv — required by targets whose Makefiles drive tooling through it
# (kale: `uv run ruff check`, `uv run pytest`; also epic-code-gen's own
# `make test-unit`). Without it those recipes exit 127, which is
# indistinguishable from a genuine lint or test failure.
# Installed to /usr/local/bin so every user in the image can reach it.
ENV UV_INSTALL_DIR=/usr/local/bin
# Checked with `test -x` rather than `uv --version`: executing the freshly
# installed amd64 binary segfaults under qemu when cross-building from arm64.
# test -x asserts the install landed without running it.
RUN curl -fsSL https://astral.sh/uv/install.sh | sh \
    && test -x /usr/local/bin/uv

# Playwright for UX prototype parsing (parse_prototype.js)
# Browsers go to /opt/playwright so both root and claude-ci can access them
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
ENV NODE_PATH=/usr/lib/node_modules
RUN npm install -g playwright \
    && npx playwright install chromium \
    && dnf install -y --nodocs \
        alsa-lib atk at-spi2-atk cups-libs libdrm libXcomposite libXdamage \
        libXrandr mesa-libgbm pango nspr nss libxkbcommon \
    && dnf clean all \
    && chmod -R 755 /opt/playwright

# Non-root user (required by Claude Code)
RUN useradd -m claude-ci \
    && mkdir -p /home/claude-ci/.local/bin \
    && chown -R claude-ci:claude-ci /home/claude-ci

# Claude Code CLI
RUN runuser -l claude-ci -c 'curl -fsSL https://claude.ai/install.sh | bash'
ENV PATH="/home/claude-ci/.claude/local/bin:/home/claude-ci/.local/bin:${PATH}"

# Superpowers plugin (SDD skill used by epic-codegen)
RUN runuser -l claude-ci -c 'claude plugin marketplace add obra/superpowers' \
    && runuser -l claude-ci -c 'claude plugin install superpowers@superpowers-dev'

# Trust /tmp/claude-workdir so Claude Code loads .claude/settings.json
RUN mkdir -p /home/claude-ci && \
    echo '{"projects":{"/tmp/claude-workdir":{"hasTrustDialogAccepted":true}}}' \
    > /home/claude-ci/.claude.json && \
    chown claude-ci:claude-ci /home/claude-ci/.claude.json

# Verify installations
RUN python3 --version \
    && go version \
    && node --version \
    && npm --version \
    && pnpm --version \
    && yarn --version \
    && eslint --version \
    && tsc --version \
    && vitest --version \
    && runuser -u claude-ci -- claude --version

USER claude-ci
WORKDIR /home/claude-ci
